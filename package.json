{
	"name": "@natlibfi/melinda-record-import-commons",
	"description": "Shared modules for microservices of Melinda record batch import system",
	"author": {
		"name": "The National Library of Finland"
	},
	"keywords": [],
	"homepage": "https://github.com/natlibfi/melinda-record-import-commons-js",
	"bugs": {
		"url": "https://github.com/natlibfi/melinda-record-import-commons-js/issues"
	},
	"repository": {
		"url": "git+https://github.com/NatLibFi/melinda-record-import-commons-js.git"
	},
	"license": "MIT",
	"version": "13.0.6",
	"main": "./dist/index.js",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc",
		"lint": "eslint ./src",
		"lint:dev": "eslint --fix ./src",
		"test:base": "node --test --test-force-exit --experimental-test-coverage --test-reporter=spec './tests/*.test.ts'",
		"test": "npm run lint && npm run test:base",
		"watch:test": "cross-env DEBUG=@natlibfi/* NODE_ENV=test node --watch --test --experimental-test-coverage --test-reporter=spec './tests/*.test.ts'",
		"dev": "npm run watch:test",
		"dev:debug": "cross-env LOG_LEVEL=debug DEBUG=@natlibfi/* NODE_ENV=test npm run watch:test"
	},
	"dependencies": {
		"@natlibfi/marc-record": "^11.0.3",
		"@natlibfi/melinda-commons": "^16.0.0",
		"amqplib": "^2.2.1",
		"debug": "^4.4.3",
		"http-status": "^2.1.0",
		"luxon": "^3.7.2",
		"mongo-sanitize": "^1.1.0",
		"mongodb": "^7.8.0",
		"openid-client": "^6.8.8",
		"uuid": "^14.0.3"
	},
	"devDependencies": {
		"@natlibfi/fixugen": "^4.0.0",
		"@natlibfi/fixugen-http-client": "^5.0.0",
		"@natlibfi/fixura": "^5.0.0",
		"@natlibfi/fixura-mongo": "^4.0.2",
		"@onify/fake-amqplib": "^3.7.0",
		"@types/amqplib": "^0.10.8",
		"@types/debug": "^4.1.13",
		"@types/luxon": "^3.7.6",
		"@types/mongo-sanitize": "^1.0.3",
		"@types/node": "^26.6.6",
		"cross-env": "^10.1.0",
		"eslint": "^10.14.0",
		"jiti": "^2.7.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	}
}